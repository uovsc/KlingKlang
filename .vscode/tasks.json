{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build library Release",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/src/KlingKlang/KlingKlang.csproj",
				"--configuration",
				"Release",
				"--output",
				"${workspaceFolder}/src/KlingKlang/bin/Release/net10.0"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "Count source lines",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoLogo",
				"-NoProfile",
				"-File",
				"${workspaceFolder}/.github/skills/count-lines/count-lines.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	]
}